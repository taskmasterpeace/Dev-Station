{
  "name": "devstation",
  "version": "1.0.0",
  "description": "Dev workstation for managing dev servers, Docker containers, and databases from one dashboard",
  "main": "server.js",
  "bin": {
    "devstation": "./server.js",
    "devd": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cli": "node cli.js",
    "build": "npm run build:win && npm run build:linux && npm run build:mac",
    "build:win": "pkg . --target node18-win-x64 --output dist/devstation-win.exe",
    "build:linux": "pkg . --target node18-linux-x64 --output dist/devstation-linux",
    "build:mac": "pkg . --target node18-macos-x64 --output dist/devstation-macos"
  },
  "files": [
    "server.js",
    "cli.js",
    "lib/",
    "public/",
    "start.bat",
    "start.sh",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taskmasterpeace/Dev-Station.git"
  },
  "homepage": "https://github.com/taskmasterpeace/Dev-Station#readme",
  "bugs": {
    "url": "https://github.com/taskmasterpeace/Dev-Station/issues"
  },
  "pkg": {
    "scripts": ["lib/**/*.js"],
    "assets": ["public/**/*"],
    "targets": ["node18-win-x64", "node18-linux-x64", "node18-macos-x64"],
    "outputPath": "dist"
  },
  "keywords": [
    "dev-server",
    "dashboard",
    "process-manager",
    "docker",
    "devtools",
    "development",
    "server-manager",
    "nodejs",
    "cli",
    "developer-tools"
  ],
  "author": {
    "name": "Machine King Labs",
    "url": "https://github.com/taskmasterpeace"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
